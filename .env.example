# Copy this file to .env and add your private API keys.

# Provider: groq or mistral
LLM_PROVIDER=groq

# Hosted LLM API keys
GROQ_API_KEY=
MISTRAL_API_KEY=

# Admin resource management. Generate a unique token outside source control.
MEDIBOT_ADMIN_TOKEN=replace-with-a-long-random-token
MEDIBOT_ADMIN_ALLOW_REMOTE=false

# Model identifiers; verify availability in your provider account
GROQ_MODEL=
MISTRAL_MODEL=

# Local embedding model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Application paths
DATA_DIR=data/raw
VECTORSTORE_DIR=vectorstore/faiss_index
MEDIBOT_AUTH_DB_PATH=data/medibot_auth.sqlite3

# Retrieval settings
RETRIEVAL_K=4

# Backend URL
MEDIBOT_API_URL=http://127.0.0.1:8000
