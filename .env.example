# Copy this file to .env and add your private API keys.

# Local SQLite is used when DATABASE_URL is unset. Set a PostgreSQL URL for a
# shared multi-user deployment. Never commit a production URL.
DATABASE_URL=

# Provider: groq
LLM_PROVIDER=groq

# Hosted LLM API keys
GROQ_API_KEY=

# Admin resource management
MEDIBOT_ADMIN_ALLOW_REMOTE=false
MEDIBOT_ADMIN_LOCAL_DEV=false
MEDIBOT_ADMIN_PASSWORD=
MEDIBOT_ADMIN_SESSION_SECRET=
# Set true when HTTPS terminates at a trusted reverse proxy.
MEDIBOT_ADMIN_COOKIE_SECURE=

# Authentication cookies are secure by default on Render. Set true for local
# HTTPS or false only for local HTTP development.
MEDIBOT_COOKIE_SECURE=false

# Stored conversations are deleted after this many inactive days (1-365).
MEDIBOT_RETENTION_DAYS=30

# Maximum chat operations per user per minute.
MEDIBOT_CHAT_RATE_LIMIT=30

# Model identifiers; verify availability in your provider account
GROQ_MODEL=

# Local embedding model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Application paths
DATA_DIR=data/raw
VECTORSTORE_DIR=vectorstore/faiss_index
HF_HOME=data/model-cache

# Retrieval settings
RETRIEVAL_K=4

# Backend URL
MEDIBOT_API_URL=http://127.0.0.1:8000
