def require_local_admin(request: Request) -> None:
    """Allow admin requests only when the ASGI peer address is loopback."""
    client = request.client

    if client is None:
        raise HTTPException(
            status_code=status.HTTP_403_FORBIDDEN,
            detail="Admin resources are available only from this machine.",
        )

    try:
        is_loopback = ipaddress.ip_address(client.host).is_loopback
    except (TypeError, ValueError):
        is_loopback = False

    if not is_loopback:
        raise HTTPException(
            status_code=status.HTTP_403_FORBIDDEN,
            detail="Admin resources are available only from this machine.",
        )


